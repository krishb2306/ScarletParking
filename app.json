    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "kingk2306",
    "extra": {
      "eas": {
        "projectId": "ab2f950a-d537-465b-80d0-a2f71af88a5c"
      }
    }
